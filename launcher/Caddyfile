# skip_install_trust: never touch any system/NSS/Java trust store or shell out to sudo.
{
	admin off
	auto_https disable_redirects
	skip_install_trust
	default_sni localhost
	# A leaf may not outlive its issuer: at the 7-day default, Caddy silently clamps the 30-day lifetime below.
	pki {
		ca local {
			intermediate_lifetime 8760h
		}
	}
	# No read_body timeout and no request_body cap: file uploads are unbounded and stream for as long as they need.
	servers {
		timeouts {
			read_header 10s
		}
	}
}

(proxy) {
	bind 0.0.0.0 ::
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		# same-origin, not no-referrer: /proxy recovers a root-relative request's target from the Referer, and no-referrer strips the only record of it. Cross-origin referrers are still withheld.
		Referrer-Policy same-origin
		-Server
	}
	reverse_proxy 127.0.0.1:8442
}

# Named so the automation policy carries `localhost` as its subject: a subject-less policy accepts `lifetime` and then ignores it.
https://localhost:8443 {
	import proxy
	# Browsers pin the click-through exception to the leaf's fingerprint, so the 12h default re-raises the warning twice a day.
	tls {
		issuer internal {
			lifetime 720h
		}
	}
}

# Host-less: routes IP-literal Host headers (e.g. 127.0.0.1), served the cert above via default_sni.
https://:8443 {
	import proxy
}
